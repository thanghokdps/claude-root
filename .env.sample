# harness — environment variables. Copy to .env (gitignored) only for the parts you use.
#
# Installing the kit needs NONE of these: scripts/install.sh uses your logged-in `claude` CLI
# and stores no secrets. The variables below are for the optional tools and the agent projects
# the agent skills build. Names only; never commit values.

# --- eval/ (evalkit, code-quality benchmark) --------------------------------------------
# Judge model for LLM-graded tasks; defaults to claude-opus-5 when unset.
EVALKIT_JUDGE_MODEL=

# --- Agent projects scaffolded by /agent-architect (put these in THAT project's .env) ----
# One model key is enough for the first real turn (agent-architect preflight checks presence only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=

# Tracing switch: none | langfuse | langsmith  (see /agent-evals observability)
TRACING_PROVIDER=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- Figma (agent-design-ui) -------------------------------------------------------------
# Only when using the Figma MCP; without it the skill reads Figma through Claude in Chrome.
FIGMA_API_KEY=
