{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git branch -D *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/agent-progress.sh pre", "statusMessage": "🤖 Spawning agent..." }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/commit-quality-gate.sh" },
          { "type": "command", "command": ".claude/hooks/risk-corroboration.sh" },
          { "type": "command", "command": ".claude/hooks/branch-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/agent-progress.sh", "statusMessage": "✅ Agent completed" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/agent-progress.sh", "statusMessage": "📝 Logging edit..." },
          { "type": "command", "command": ".claude/hooks/blast-radius-check.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/agent-progress.sh", "statusMessage": "💻 Logging command..." },
          { "type": "command", "command": ".claude/hooks/save-commit-memory.sh" }
        ]
      }__STACK_HOOKS__
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/scope-gate.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/state-breadcrumb.sh" },
          { "type": "command", "command": ".claude/hooks/session-handoff.sh", "statusMessage": "📋 Writing specs/HANDOFF.md..." }
        ]
      }
    ]
  }
}
